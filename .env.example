# ============================================================
# K-Delta Environment Security Configuration Template
# DO NOT COMMIT REAL CREDENTIALS OR SECRETS TO THIS FILE
# ============================================================

# Server Setup
PORT=3000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Authentication & Session Secrets
# Replace with 64+ char random hex string in production (e.g., openssl rand -hex 32)
JWT_SECRET=your_super_secret_jwt_key_change_in_production_32_bytes
SESSION_SECRET=your_super_secret_session_key_change_in_production

# Market Data Security & Provider API Credentials (Server-Side Only)
# Never expose these keys in React or client-side JavaScript bundle
MARKET_DATA_PRIMARY_KEY=placeholder_primary_api_key
MARKET_DATA_BACKUP_KEY=placeholder_backup_api_key
MARKET_DATA_PROVIDER_URL=https://api.marketprovider.com/v1

# Security & Rate Limiting Controls
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX_REQUESTS=120
AUTH_RATE_LIMIT_MAX_REQUESTS=10
WS_MAX_CONNECTIONS_PER_IP=5
CACHE_TTL_SECONDS=15
